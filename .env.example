# ── 应用 ─────────────────────────────────────────────────
APP_NAME=FinAgent
APP_VERSION=0.1.0
DEBUG=true

# ── LLM: DeepSeek ────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Embedding: 硅基流动 BGE-M3 ────────────────────────────
# 注册送 2000 万 tokens: https://siliconflow.cn
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ── 数据源: Tushare Pro ──────────────────────────────────
# 需 2000+ 积分: https://tushare.pro
TUSHARE_TOKEN=your_tushare_token_here

# ── 基础设施 ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finagent:finagent_dev_password@localhost:5432/finagent
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
